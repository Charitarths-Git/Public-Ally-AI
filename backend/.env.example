# backend/.env.example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Django ────────────────────────────────────────────────────────────────────
# REQUIRED. Generate a fresh key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# The previous default key was exposed in the repository history and must NOT be reused.
SECRET_KEY=your-new-secret-key-here

# Set to True only in local development. Must be False in production.
DEBUG=False

# Comma-separated list of allowed host/domain names.
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Supabase Database ─────────────────────────────────────────────────────────
SUPABASE_DB_HOST=your-supabase-host.supabase.co
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_DB_PORT=5432

# ── Supabase SDK ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ── VAPI (Voice AI) ───────────────────────────────────────────────────────────
VAPI_API_KEY=your-vapi-api-key
PHONE_NUMBER_ID=your-vapi-phone-number-id

# ── Google APIs ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
# Paste the full JSON content of your service account key file as a single line.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"..."}

# ── Deployment ────────────────────────────────────────────────────────────────
# The publicly accessible URL of the deployed backend (used in CORS, webhooks, etc.)
DEPLOYED_URL=https://your-backend-url.example.com
